# FRP Orchestrator Environment Variables Example
# Copy to .env or load into systemd environment

# Master API key for Controller REST API and CLI administration
CONTROLLER_API_KEY=change-this-to-a-secure-random-token-32-chars

# Pterodactyl Application API Key (read-only or full application access)
PTERODACTYL_API_KEY=ptla_your_pterodactyl_application_api_key_here

# FRP Gateway shared authentication token (configured on gateways and agents)
FRP_GATEWAY_TOKEN=generate-a-strong-random-gateway-token-64-chars

# FRP Node Agent authentication token
FRP_AGENT_TOKEN=secure-node-agent-token-here

# Local FRP client admin API password
FRPC_ADMIN_PASSWORD=strong-frpc-admin-password

# Cloudflare DNS API Token (Optional, only needed if dns.cloudflare.enabled = true)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_dns_edit_permissions
