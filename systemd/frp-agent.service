[Unit]
Description=FRP Node Agent Daemon (Pterodactyl Node)
Documentation=https://github.com/UG88/frp-orchestrator
After=network.target network-online.target wings.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/frp
ExecStart=/usr/local/bin/frp-agent --config /etc/frp-agent/agent.toml
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Environment file with secrets
EnvironmentFile=-/etc/frp-agent/agent.env

[Install]
WantedBy=multi-user.target
